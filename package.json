{
  "name": "azure-devops-mcp-safe",
  "version": "0.1.0-alpha.0",
  "description": "An independently maintained, read-only MCP server for Azure DevOps",
  "license": "MIT",
  "author": "Tony",
  "homepage": "https://github.com/t0nyba11/azure-devops-mcp-safe",
  "bugs": "https://github.com/t0nyba11/azure-devops-mcp-safe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0nyba11/azure-devops-mcp-safe.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "azure-devops-mcp-safe": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node -p \"'export const packageVersion = ' + JSON.stringify(require('./package.json').version) + ';\\n'\" > src/version.ts && prettier --write src/version.ts",
    "validate-tools": "tsc --noEmit && node scripts/build-validate-tools.js",
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "inspect": "ALLOWED_ORIGINS=http://127.0.0.1:6274 npx @modelcontextprotocol/inspector@0.21.0 node dist/index.js",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "clean": "shx rm -rf dist",
    "test": "jest",
    "prepublishOnly": "node -e \"if (process.env.npm_config_tag !== 'alpha') { console.error('Refusing to publish without --tag alpha'); process.exit(1) }\" && npm test && npm run validate-tools",
    "prepack": "npm run build",
    "release:alpha": "npm publish --tag alpha"
  },
  "dependencies": {
    "@azure/identity": "^4.10.0",
    "@azure/msal-node": "^5.0.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "azure-devops-extension-api": "^5.272.3",
    "azure-devops-extension-sdk": "^4.0.2",
    "azure-devops-node-api": "^15.1.2",
    "winston": "^3.18.3",
    "yargs": "^18.0.0",
    "zod": "^3.25.63",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.1",
    "glob": "^13.0.0",
    "jest": "^30.0.2",
    "jest-extended": "^7.0.0",
    "prettier": "3.9.5",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
